  "keywords": [
    "video-downloader",
    "social-media-downloader",
    "youtube-downloader",
    "instagram-downloader",
    "tiktok-downloader",
    "twitter-video-downloader",
    "facebook-video-downloader",
    "yt-dlp",
    "cli",
    "bun"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vargHQ/social-media-video-downloader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/vargHQ/social-media-video-downloader.git"
  },
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "vdl": "src/cli.ts"
  },
  "scripts": {
    "vdl": "bun src/cli.ts",
